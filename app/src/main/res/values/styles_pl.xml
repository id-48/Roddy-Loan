<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.SplashLogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="PLTextView">
        <item name="android:textColor">@color/colorText</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/app_font_style</item>
    </style>
    <style name="PLTextView.Headline" parent="@style/PLTextView">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorText</item>
    </style>
    <style name="PLTextView.Title" parent="@style/PLTextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PLTextView.Subtitle" parent="@style/PLTextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PLTextView.Body" parent="@style/PLTextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorSubText</item>
    </style>
    <style name="PLTextView.Label" parent="@style/PLTextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorSubText</item>
    </style>

    <style name="PLButton" parent="@style/Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/app_font_style</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="PLButton.Primary" parent="@style/PLButton">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="PLButton.Outline" parent="@style/PLButton">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="PLTextInputLayout" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">@font/app_font_style</item>
        <item name="boxBackgroundColor">@color/colorInputBackground</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>
    <style name="PLTextInputEditText" parent="@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:fontFamily">@font/app_font_style</item>
    </style>
    <style name="PLRadioButton" parent="@style/Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/app_font_style</item>
        <item name="android:paddingStart">8dp</item>
        <item name="buttonTint">@color/colorPrimary</item>
    </style>
    <style name="PLSwitch" parent="@style/Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/colorPrimary</item>
    </style>
    <style name="PLCard" parent="@style/Widget.MaterialComponents.CardView">
        <item name="android:layout_margin">5dp</item>
        <item name="cardBackgroundColor">@color/colorCard</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/colorCardBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
