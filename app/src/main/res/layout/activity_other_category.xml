                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_other_unit"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Unit"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCashCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_other_cash"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Cash Counter"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNumToWordCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_other_numword"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Num to Word"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPetrolCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
