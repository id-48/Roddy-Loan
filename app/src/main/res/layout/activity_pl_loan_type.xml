<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/pl_init_progress_header"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="15dp"
            android:paddingTop="5dp"
            android:paddingRight="15dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="15dp"
            android:paddingVertical="5dp">
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginVertical="5dp"
                layout="@layout/put_big_nativead"/>
            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Loan Type"
                style="@style/PLTextView.Headline"/>
            <TextView
                android:id="@+id/tvSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="5dp"
                android:text="Choose the loan that fits your need"
                style="@style/PLTextView.Body"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/btnPersonalLoan"
                        android:background="@android:color/transparent"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/colorText"
                            android:id="@+id/tvOpt1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Personal Loan"
                            style="@style/PLTextView.Body"/>
                        <ImageView
                            android:id="@+id/ivCheckPersonal"
                            android:visibility="visible"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <View
                        android:background="@color/colorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginHorizontal="20dp"/>
                    <RelativeLayout
                        android:id="@+id/btnBusinessLoan"
                        android:background="@android:color/transparent"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/colorText"
                            android:id="@+id/tvOpt2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Business Loan"
                            style="@style/PLTextView.Body"/>
                        <ImageView
                            android:id="@+id/ivCheckBusiness"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <View
                        android:background="@color/colorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginHorizontal="20dp"/>
                    <RelativeLayout
                        android:id="@+id/btnHomeLoan"
                        android:background="@android:color/transparent"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/colorText"
                            android:id="@+id/tvOpt3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home Loan"
                            style="@style/PLTextView.Body"/>
                        <ImageView
                            android:id="@+id/ivCheckHome"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <View
                        android:background="@color/colorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginHorizontal="20dp"/>
                    <RelativeLayout
                        android:id="@+id/btnVehicleLoan"
                        android:background="@android:color/transparent"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/colorText"
                            android:id="@+id/tvOpt4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle Loan"
                            style="@style/PLTextView.Body"/>
                        <ImageView
                            android:id="@+id/ivCheckVehicle"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
</LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="5dp"
        android:text="@string/btn_next"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="5dp"
        app:cornerRadius="12dp"
        style="@style/PLButton.Primary"/>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
