<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/pl_init_progress_header"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
<TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Information"
                android:textAlignment="center"
                style="@style/PLTextView.Headline"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_golden_premium"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_gravity="center"
                    android:id="@+id/tvPremiumTag"
                    android:background="#9e700e"
                    android:paddingLeft="16dp"
                    android:paddingTop="6dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREMIUM ELIGIBILITY DETECTED"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/interestrate"
                        android:layout_marginEnd="5dp"
                        app:tint="#5d4037"/>
                    <TextView
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="#5d4037"
                        android:id="@+id/tvRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.5%"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#5d4037"
                    android:layout_gravity="center"
                    android:id="@+id/tvLowInterest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="VERIFIED PRE-APPROVED RATE"/>
                <View
                    android:background="#5d4037"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:alpha="0.5"
                    android:layout_marginVertical="5dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#5d4037"
                    android:id="@+id/tvBenefitsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Exclusive Benefits:"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llBenefit1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="#5d4037"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#5d4037"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero processing fee for first 3 months"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llBenefit2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="#5d4037"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#5d4037"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant approval with minimal documents"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="#5d4037"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#5d4037"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flexible repayment options"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/tvSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Based on current information."
                android:textAlignment="center"
                style="@style/PLTextView.Body"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layoutComparison"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#ef4444"
                    android:id="@+id/tvOldRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    android:layout_marginHorizontal="8dp"
                    app:tint="@color/colorPrimary"/>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#00a34d"
                    android:id="@+id/tvNewRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginVertical="5dp"
                layout="@layout/put_big_nativead2"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="5dp"
        android:text="@string/btn_continue"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="5dp"
        app:cornerRadius="12dp"
        style="@style/PLButton.Primary"/>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
