<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/pl_toolbar"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layoutFetching"
            android:background="@color/colorBackground"
            android:padding="20dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/fetchingProgress"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:layout_centerInParent="true"
                        app:indicatorColor="@color/colorPrimary"
                        app:indicatorSize="100dp"
                        app:trackColor="#f1f5f9"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"/>
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/timer"
                        android:layout_centerInParent="true"
                        android:contentDescription="@null"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textColor="@color/colorText"
                android:id="@+id/tvFetchingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Finding best offers..."
                android:textAlignment="center"
                style="@style/PLTextView.Title"/>

            <TextView
                android:id="@+id/tvFetchingSubStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Matching banks to your profile"
                android:textAlignment="center"
                style="@style/PLTextView.Body"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutMainContent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:paddingBottom="15dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose an Offer"
                        style="@style/PLTextView.Headline"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:text="Select one offer and continue"
                        style="@style/PLTextView.Body"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/containerOffers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:background="@color/white">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccept"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Accept Offer"
                    app:cornerRadius="14dp"
                    style="@style/PLButton.Primary"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
