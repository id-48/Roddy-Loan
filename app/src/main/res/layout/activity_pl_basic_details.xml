<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/pl_init_progress_header"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
<com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Basic Details"
                        style="@style/PLTextView.Headline"/>
                    <TextView
                        android:id="@+id/tvSubtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Please provide your information to continue"
                        style="@style/PLTextView.Body"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Full Name"
                        style="@style/PLTextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            style="@style/PLTextInputEditText"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date of Birth"
                        style="@style/PLTextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDob"
                            android:focusable="false"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            style="@style/PLTextInputEditText"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/tvGenderLbl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Select Gender"
                        style="@style/PLTextView.Subtitle"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rgGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">
                        <RadioButton
                            android:textColor="@color/selector_gender_text"
                            android:gravity="center"
                            android:id="@+id/rbMale"
                            android:background="@drawable/selector_gender_button"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="Male"
                            android:drawablePadding="8dp"
                            android:layout_weight="1"
                            android:drawableEnd="@drawable/selector_gender_check"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:layout_marginEnd="8dp"
                            android:drawableTint="@color/white"
                            style="@style/PLRadioButton"/>
                        <RadioButton
                            android:textColor="@color/selector_gender_text"
                            android:gravity="center"
                            android:id="@+id/rbFemale"
                            android:background="@drawable/selector_gender_button"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="Female"
                            android:drawablePadding="8dp"
                            android:layout_weight="1"
                            android:drawableEnd="@drawable/selector_gender_check"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:layout_marginStart="8dp"
                            android:drawableTint="@color/white"
                            style="@style/PLRadioButton"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                layout="@layout/put_big_nativead2"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="5dp"
        android:text="@string/btn_continue"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="5dp"
        app:cornerRadius="12dp"
        style="@style/PLButton.Primary"/>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
