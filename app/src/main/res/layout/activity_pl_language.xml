<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="8dp">
    <include layout="@layout/pl_init_progress_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/language_headline"
            android:textAlignment="center"
            style="@style/PLTextView.Headline"/>
        <TextView
            android:id="@+id/tvSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/language_subtext"
            android:textAlignment="center"
            style="@style/PLTextView.Body"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginHorizontal="5dp"
                    layout="@layout/put_big_nativead"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/btnEnglish"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagEnglish"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇬🇧"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOpt1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="English ($)"
                                android:layout_toRightOf="@+id/tvFlagEnglish"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckEnglish"
                                android:visibility="visible"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnHindi"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagHindi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇮🇳"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOpt2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="हिंदी (Hindi) (₹)"
                                android:layout_toRightOf="@+id/tvFlagHindi"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckHindi"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnVietnamese"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagViet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇻🇳"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptVietnamese"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="Tiếng Việt (Vietnamese) (₫)"
                                android:layout_toRightOf="@+id/tvFlagViet"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckVietnamese"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnUrdu"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagUrdu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇵🇰"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptUrdu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="اردو (Urdu) (₨)"
                                android:layout_toRightOf="@+id/tvFlagUrdu"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckUrdu"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnSpanish"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagSpan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇪🇸"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptSpanish"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="Español (Spanish) (€)"
                                android:layout_toRightOf="@+id/tvFlagSpan"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckSpanish"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnIndonesian"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagIndo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇮🇩"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptIndonesian"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="Bahasa Indonesia (Rp)"
                                android:layout_toRightOf="@+id/tvFlagIndo"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckIndonesian"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnFilipino"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagFili"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇵🇭"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptFilipino"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="Filipino (₱)"
                                android:layout_toRightOf="@+id/tvFlagFili"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckFilipino"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnSwahili"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagSwah"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇰🇪"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptSwahili"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="Kiswahili (Swahili) (KSh)"
                                android:layout_toRightOf="@+id/tvFlagSwah"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckSwahili"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnPortuguese"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagPort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇵🇹"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptPortuguese"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="Português (Portuguese) (€)"
                                android:layout_toRightOf="@+id/tvFlagPort"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckPortuguese"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <View
                            android:background="@color/colorDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"/>
                        <RelativeLayout
                            android:id="@+id/btnBengali"
                            android:background="?attr/selectableItemBackground"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="20sp"
                                android:id="@+id/tvFlagBeng"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇧🇩"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvOptBengali"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="বাংলা (Bengali) (৳)"
                                android:layout_toRightOf="@+id/tvFlagBeng"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/app_font_style"/>
                            <ImageView
                                android:id="@+id/ivCheckBengali"
                                android:visibility="gone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <Button
        android:id="@+id/btnNext"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="5dp"
        android:text="@string/btn_next"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="5dp"
        style="@style/PLButton.Primary"/>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
