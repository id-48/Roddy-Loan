<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plProgressHeaderRoot"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="2dp"
    android:paddingHorizontal="16dp">

    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rvFakeApprovals"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:id="@+id/tvStepCount"
            android:background="@color/colorProgressBg"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1/23"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>

        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:ellipsize="end"
            android:id="@+id/tvMilestone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Getting started with your application..."
            android:maxLines="1"
            android:layout_weight="1"/>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/linearProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        app:indicatorColor="@color/colorPrimary"
        app:trackColor="@color/colorProgressBg"
        app:trackCornerRadius="6dp"
        app:trackThickness="8dp"/>
</LinearLayout>
