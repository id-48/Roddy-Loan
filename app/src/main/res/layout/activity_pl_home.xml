<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/pl_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:padding="10dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/homeContentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLoanOffer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:cardCornerRadius="8dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="70dp"
                            android:src="@drawable/icc_loan_amount"
                            android:scaleType="fitXY"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/tvLoanOfferTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_loan_offer_title"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:id="@+id/tvLoanOfferSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/home_loan_offer_subtitle"/>
                            <com.google.android.material.button.MaterialButton
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                android:id="@+id/btnApplyNow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_loan_offer_apply"
                                android:visibility="gone"
                                android:backgroundTint="@color/white"
                                app:cornerRadius="20dp"
                                style="@style/Widget.MaterialComponents.Button.TextButton"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLoanStatus"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    app:cardBackgroundColor="#f8fffa"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#cecece"
                    app:strokeWidth="0.5dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_alignParentStart="true">
                                <ImageView
                                    android:background="@drawable/bg_status_badge"
                                    android:padding="8dp"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_home_loans"
                                    android:backgroundTint="#dcfce7"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorText"
                                        android:id="@+id/tvStatusTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Loan Tracker"/>
                                    <TextView
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorPrimary"
                                        android:id="@+id/tvStatusAmount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Amount: ₹0"/>
                                </LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_status_badge"
                                android:paddingLeft="10dp"
                                android:paddingTop="4dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LIVE"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"/>
                        </RelativeLayout>
                        <View
                            android:background="#e2e8f0"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:layout_marginVertical="12dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="13sp"
                                    android:textColor="@color/colorSubText"
                                    android:id="@+id/tvStatusSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Step 1: Application Received"/>
                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/pbStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginEnd="16dp"
                                    app:indicatorColor="@color/colorPrimary"
                                    app:trackColor="#e2e8f0"
                                    app:trackCornerRadius="4dp"
                                    app:trackThickness="6dp"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/colorSubText"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    layout="@layout/put_big_nativead"/>
                <GridLayout
                    android:id="@+id/gridGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:columnCount="2"
                    android:layout_marginVertical="5dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardAllLoans"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_home_loans"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatAllLoans"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/cat_all_loans"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardEpfServices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_home_epf"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatEpf"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/cat_epf_services"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardLoanGuide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_home_guide"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatLoanGuide"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/cat_loan_guide"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardInsurance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_home_insurance"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatInsurance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/cat_insurance_policy"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
                <TextView
                    android:textStyle="bold"
                    android:id="@+id/tvHomeCalculators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/home_calculators"
                    android:layout_marginVertical="10dp"
                    style="@style/PLTextView.Subtitle"/>
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardBankingCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_cat_banking"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatBanking"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_banking"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvBankingDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_banking"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardLoanCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_cat_loan"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatLoan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_loan"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvLoanDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_loan"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardFinancialCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_cat_finance"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatFinancial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_financial"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvFinancialDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_financial"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardMutualCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="45dp"
                                android:src="@drawable/ic_cat_mutual"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatMutual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_mutual"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvMutualDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_mutual"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardStockCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_cat_stock"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatStock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_stock"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvStockDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_stock"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardGstCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="47dp"
                                android:src="@drawable/ic_cat_gst"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatGst"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_gst"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvGstDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_gst"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="fill"
                        android:id="@+id/cardOtherCat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="40dp"
                        android:layout_columnWeight="1"
                        app:cardElevation="2dp"
                        style="@style/PLCard">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_cat_other"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@+id/tvCatOther"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_cat_other"
                                android:textAlignment="center"
                                style="@style/PLTextView.Subtitle"/>
                            <TextView
                                android:textSize="10sp"
                                android:id="@+id/tvOtherDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/desc_other"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/put_bannerad"/>
    </LinearLayout>
</LinearLayout>
