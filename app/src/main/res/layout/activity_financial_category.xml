<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/pl_toolbar"/>
    <ScrollView
        android:padding="15dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                layout="@layout/put_big_nativead"/>
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignBounds"
                android:useDefaultMargins="false">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDiscountCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_discount"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Discount"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInflationCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_inflation"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Inflation"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPriceCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_price"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Price"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTvmCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_tvm"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="TVM"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurrencyCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_currency"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Currency"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTipsCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_tips"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Tips"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMarginCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_margin"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Margin"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCumulativeCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_cumulative"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Cumulative"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSalesTaxCalc"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_margin="4dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    app:cardElevation="2dp"
                    style="@style/PLCard">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_fin_sales_tax"/>
                        <TextView
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Sales Tax"
                            android:textAlignment="center"
                            style="@style/PLTextView"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
