<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer placeholder until native ad binds (loan EMI style). -->
<com.loan.emi.calculator.loanemicalc.finance.bankingcalculator.financialcalculator.ads.ui.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_ad_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="2.4"
                android:background="@drawable/bg_shimmer_block" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_shimmer_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_shimmer_block" />

                <View
                    android:layout_width="72dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_shimmer_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_shimmer_block" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.loan.emi.calculator.loanemicalc.finance.bankingcalculator.financialcalculator.ads.ui.ShimmerLayout>
