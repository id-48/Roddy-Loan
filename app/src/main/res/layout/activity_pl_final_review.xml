<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/pl_init_progress_header"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvHeadline"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Review"
                android:paddingHorizontal="4dp"
                style="@style/PLTextView.Headline"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="#1100a34d"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:text="Loan Amount"
                                style="@style/PLTextView.Label"/>
                            <TextView
                                android:textSize="20sp"
                                android:textColor="@color/colorPrimary"
                                android:id="@+id/resAmount"
                                android:layout_marginTop="4dp"
                                style="@style/PLTextView.Headline"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="end"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:text="Monthly EMI"
                                style="@style/PLTextView.Label"/>
                            <TextView
                                android:textSize="20sp"
                                android:textColor="@color/colorText"
                                android:id="@+id/resEmi"
                                android:layout_marginTop="4dp"
                                style="@style/PLTextView.Headline"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:background="@color/colorDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:text="Name"
                                    style="@style/PLTextView.Label"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:id="@+id/resName"
                                    style="@style/PLTextView.Subtitle"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:text="Mobile"
                                    style="@style/PLTextView.Label"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:id="@+id/resMobile"
                                    style="@style/PLTextView.Subtitle"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:text="Email"
                                    style="@style/PLTextView.Label"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:ellipsize="end"
                                    android:id="@+id/resEmail"
                                    android:maxLines="1"
                                    style="@style/PLTextView.Subtitle"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:text="DOB"
                                    style="@style/PLTextView.Label"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:id="@+id/resDob"
                                    style="@style/PLTextView.Subtitle"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:text="Gender"
                                    style="@style/PLTextView.Label"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:id="@+id/resGender"
                                    style="@style/PLTextView.Subtitle"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:text="Employment"
                                    style="@style/PLTextView.Label"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:id="@+id/resJob"
                                    style="@style/PLTextView.Subtitle"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:text="Address"
                                style="@style/PLTextView.Label"/>
                            <TextView
                                android:textSize="14sp"
                                android:ellipsize="end"
                                android:id="@+id/resAddress"
                                android:maxLines="2"
                                style="@style/PLTextView.Subtitle"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <CheckBox
                android:id="@+id/cbTerms"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="I agree to the terms and conditions."
                android:buttonTint="@color/colorPrimary"
                android:paddingHorizontal="4dp"
                style="@style/PLTextView.Subtitle"/>
            <include
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginVertical="10dp"
                layout="@layout/put_big_nativead"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:background="@color/colorSurface"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_submit"
            app:cornerRadius="12dp"
            style="@style/PLButton.Primary"/>
    </LinearLayout>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
