<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:elevation="4dp"
        app:navigationIcon="@drawable/ic_back">
        <TextView
            android:textSize="18sp"
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application Status"
            style="@style/PLTextView.Title"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp"
                style="@style/PLCard">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">
                        <TextView
                            android:id="@+id/tvProgressTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/btnRefresh"
                            android:layout_alignParentStart="true"
                            android:text="Application Progress"
                            style="@style/PLTextView.Title"/>
                        <com.google.android.material.button.MaterialButton
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/btnRefresh"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="Refresh"
                            android:layout_centerVertical="true"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_alignParentEnd="true"
                            android:backgroundTint="@color/colorPrimary"
                            android:paddingHorizontal="12dp"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_refresh"
                            app:iconPadding="4dp"
                            app:iconSize="14dp"
                            app:iconTint="@color/white"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivStep1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/checked"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvStep1Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/colorSuccess"
                                android:id="@+id/tvStep1Date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/btnTrackStep1"
                                android:background="@drawable/bg_chip_button"
                                android:paddingLeft="16dp"
                                android:paddingTop="6dp"
                                android:paddingRight="16dp"
                                android:paddingBottom="6dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="View"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/line1"
                        android:background="@color/colorDivider"
                        android:layout_width="2dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="11dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivStep2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_radio_button_unchecked"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvStep2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/colorSuccess"
                                android:id="@+id/tvStep2Date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/btnTrackStep2"
                                android:background="@drawable/bg_chip_button"
                                android:paddingLeft="16dp"
                                android:paddingTop="6dp"
                                android:paddingRight="16dp"
                                android:paddingBottom="6dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="View"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/line2"
                        android:background="@color/colorDivider"
                        android:layout_width="2dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="11dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivStep3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_radio_button_unchecked"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/colorText"
                                android:id="@+id/tvStep3Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/colorPrimary"
                                android:id="@+id/tvStep3Date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/btnTrackStep3"
                                android:background="@drawable/bg_chip_button"
                                android:paddingLeft="16dp"
                                android:paddingTop="6dp"
                                android:paddingRight="16dp"
                                android:paddingBottom="6dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="View"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/line3"
                        android:background="@color/colorDivider"
                        android:layout_width="2dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="11dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.5">
                        <ImageView
                            android:id="@+id/ivStep4"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_radio_button_unchecked"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/colorSubText"
                                android:id="@+id/tvStep4Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/colorSubText"
                                android:id="@+id/tvStep4Date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/btnTrackStep4"
                                android:background="@drawable/bg_chip_button"
                                android:paddingLeft="16dp"
                                android:paddingTop="6dp"
                                android:paddingRight="16dp"
                                android:paddingBottom="6dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="View"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginVertical="5dp"
                layout="@layout/put_big_nativead"/>
            <TextView
                android:id="@+id/lblLoanDetails"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="Loan Summary"
                android:paddingHorizontal="10dp"
                style="@style/PLTextView.Subtitle"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp"
                style="@style/PLCard">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/rowAmount"
                        layout="@layout/item_summary_row"/>
                    <include
                        android:id="@+id/rowRate"
                        layout="@layout/item_summary_row"/>
                    <include
                        android:id="@+id/rowTenure"
                        layout="@layout/item_summary_row"/>
                    <include
                        android:id="@+id/rowEmi"
                        layout="@layout/item_summary_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginVertical="5dp"
                layout="@layout/put_big_nativead2"/>
            <TextView
                android:id="@+id/lblPersonalDetails"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="Personal Details"
                android:paddingHorizontal="10dp"
                style="@style/PLTextView.Subtitle"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp"
                style="@style/PLCard">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/rowName"
                        layout="@layout/item_summary_row"/>
                    <include
                        android:id="@+id/rowMobile"
                        layout="@layout/item_summary_row"/>
                    <include
                        android:id="@+id/rowEmail"
                        layout="@layout/item_summary_row"/>
                    <include
                        android:id="@+id/rowEmployment"
                        layout="@layout/item_summary_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="Recommended for You"
                android:paddingHorizontal="10dp"
                style="@style/PLTextView.Subtitle"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp"
                style="@style/PLCard">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Improve your profile while we verify your application."/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreCalculators"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Explore Other Loan Types"
                        app:strokeColor="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckInsurance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Check Loan Insurance Offers"
                        app:strokeColor="@color/colorPrimary"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
</LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="4dp"
        android:text="Back to Dashboard"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="4dp"
        style="@style/PLButton.Primary"/>
    <include layout="@layout/put_bannerad"/>
</LinearLayout>
